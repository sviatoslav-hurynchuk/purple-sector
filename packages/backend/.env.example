PORT=3001
NODE_ENV=development

# Jolpica F1 API
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# OpenF1 API
OPENF1_BASE_URL=https://api.openf1.org/v1

# Upstash Redis (optional — leave empty to use in-memory fallback)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXXXXXXX...

# Admin Auth Token (required for admin cache management endpoints)
ADMIN_CACHE_KEY=your_secure_admin_token_here

# Optional Speech-to-Text for Team Radio Transcription (Groq Whisper or OpenAI Whisper)
# Leave a key empty to disable that provider. Groq is tried first when set.
GROQ_API_KEY=
OPENAI_API_KEY=

# CORS Allowed Origins (comma-separated exact origins, e.g. http://localhost:3000,https://purple-sector-sviatoslav.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,https://purple-sector-sviatoslav.vercel.app
